{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@kovanica/comms": ["../../packages/comms/src/index.ts"],
      "@kovanica/signer": ["../../packages/signer/src/index.ts"],
      "@kovanica/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": ["src"]
}

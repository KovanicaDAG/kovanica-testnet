# Monorepo layout: component dirs are tracked in this branch.
# Only runtime/unversioned content is ignored. agent + brain-vault
# remain separate repos at ~/kovanica-agent and ~/kovanica-brain-vault.
/trezor-coin-def/

# Cargo build output. Unanchored, so it covers every workspace in the tree
# (protocol/, node/, sdk/, ledger-app/, wallet/) — protocol/target alone is
# ~16 GB and was previously untracked-but-committable, since only the nested
# per-crate .gitignore files existed.
target/

# Runtime data (unversioned content inside data/ handled by data/.gitignore)
*.log
.dev.log

# Local environment / secrets (never commit)
.env
.env.*
!.env.example

# Packed planning source (docs in docs/ are canonical)
/plans/*.zip

# Obsidian vault: a generated projection of this repo's docs, and its own git
# repo. Tracked by scripts/build-vault.py -> ./vault, synced separately.
/vault/

# Vault transfer archives (regenerate with ./scripts/build-vault.sh --zip)
/dist/
# Testnet authority keys (secret)
authority-keys/*.env
